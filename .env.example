# Local dev (`bun run dev`). Port must match what alchemy dev serves on.
BETTER_AUTH_URL=http://localhost:1337

# OAuth App — signs users in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App — comments on pull requests as the bot.
# Dev uses a separate App (proxycroc-dev) whose only callback URL is
# localhost: GitHub always redirects to an App's *first* callback URL and
# ignores redirect_uri, so one App cannot serve both dev and prod.
GITHUB_APP_ID=4814105
GITHUB_APP_SLUG=proxycroc-dev
# base64 of the .pem downloaded from the App's settings page:
#   base64 < proxycroc.*.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=
