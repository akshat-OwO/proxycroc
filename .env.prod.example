# Loaded by `bun run deploy` (alchemy deploy --env-file .env.prod).
# Replaces .env entirely for that command, so every variable the deploy needs
# must be listed here — not just the ones that differ from dev.
BETTER_AUTH_URL=https://proxycroc.4kshat.dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=4813722
GITHUB_APP_SLUG=proxycroc
# base64 of the .pem downloaded from the GitHub App settings page:
#   base64 < proxycroc.*.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=
